[Unit]
Description=Seek First / God's Eye View hosted runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gev
Group=gev
WorkingDirectory=/opt/seek-first
EnvironmentFile=/etc/seek-first/gev.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run start:hosted
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/seek-first/.gev-cache
UMask=0077

[Install]
WantedBy=multi-user.target
