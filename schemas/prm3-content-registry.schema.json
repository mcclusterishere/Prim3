{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prim3.local/schemas/prm3-content-registry.schema.json",
  "title": "PRIM3 Content Registry",
  "description": "DRAFT contract for PRIM3 reference content (definitions, typed attributes, relations, field dictionary, sources, open issues). Adopted 2026-11-02 from the owner-supplied attributes matrix. A registry describes content; it never changes gameplay by itself. Cross-record rules (unique IDs, referential integrity, unknown is never zero, summary parity) are enforced by data/attributes/tools/validate_registry.py, because JSON Schema cannot express them.",
  "type": "object",
  "required": ["schemaVersion", "title", "generatedAt", "sourceRevisions", "statePolicy", "summary", "entities", "sources", "fields", "issues"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "scope": {"type": "string"},
    "sourceRevisions": {"type": "object", "additionalProperties": {"type": "string"}},
    "statePolicy": {
      "type": "object",
      "required": ["defined", "unknown", "not_applicable", "conflict"],
      "additionalProperties": {"type": "string"}
    },
    "summary": {
      "type": "object",
      "required": ["entities", "attributes", "relationships", "sources", "fields", "issues"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "count"],
        "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "count": {"type": "integer", "minimum": 0}}
      }
    },
    "supplementary": {"type": "object", "additionalProperties": {"type": "string"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$"},
    "sourceIds": {"type": "array", "items": {"type": "string", "pattern": "^src\\.[0-9a-f]+$"}},
    "sourceStatus": {
      "description": "Where a definition stands. Independent of implementation.",
      "enum": ["canon", "proposed", "draft", "reference", "runtime", "legacy", "deprecated"]
    },
    "implementationStatus": {
      "description": "Whether the definition exists in a playable game. A canon definition can be design_only; a usable model can be proposed art.",
      "enum": ["runtime", "asset_only", "design_only", "schema_only"]
    },
    "entity": {
      "description": "A stable definition. Deployed actors, held items and placed objects are separate instance entities with their own IDs.",
      "type": "object",
      "required": ["id", "name", "kind", "category", "status", "implementation", "description", "tags", "sourceIds", "attributes", "relations", "gaps"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "name": {"type": "string"},
        "kind": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/sourceStatus"},
        "implementation": {"$ref": "#/$defs/implementationStatus"},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "sourceIds": {"$ref": "#/$defs/sourceIds"},
        "attributes": {"type": "array", "items": {"$ref": "#/$defs/attribute"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "preview": {"type": ["string", "null"]}
      }
    },
    "attribute": {
      "description": "unknown and not_applicable carry value null and are never zero; conflict carries the competing source claims.",
      "type": "object",
      "required": ["key", "label", "value", "state", "unit", "origin", "sourceIds", "note"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "state": {"enum": ["defined", "unknown", "not_applicable", "conflict"]},
        "unit": {"type": ["string", "null"]},
        "origin": {"enum": ["canon", "proposed", "runtime", "reference", "draft", "legacy"]},
        "sourceIds": {"$ref": "#/$defs/sourceIds"},
        "note": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"enum": ["unknown", "not_applicable"]}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "defined"}}}, "then": {"properties": {"value": {"not": {"type": "null"}}}}},
        {"if": {"properties": {"state": {"const": "conflict"}}}, "then": {"properties": {"value": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["value", "sourceId"]}}}}}
      ]
    },
    "relation": {
      "type": "object",
      "required": ["type", "targetId", "note"],
      "properties": {"type": {"type": "string", "minLength": 1}, "targetId": {"$ref": "#/$defs/stableId"}, "note": {"type": ["string", "null"]}}
    },
    "field": {
      "type": "object",
      "required": ["key", "label", "type", "unit", "description", "appliesTo", "requiredFor"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object", "reference", "mixed"]},
        "unit": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "appliesTo": {"type": "array", "items": {"type": "string"}},
        "requiredFor": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "path", "repository", "commit", "declaredStatus", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^src\\.[0-9a-f]+$"},
        "path": {"type": "string"},
        "repository": {"type": "string"},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$", "description": "null for an uncommitted proposal file"},
        "declaredStatus": {"type": "string"},
        "url": {"type": "string"},
        "localPath": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "issue": {
      "type": "object",
      "required": ["id", "severity", "entityIds", "description", "resolution", "sourceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["review", "missing", "blocking"]},
        "entityIds": {"type": "array", "items": {"$ref": "#/$defs/stableId"}},
        "description": {"type": "string"},
        "resolution": {"type": ["string", "null"]},
        "sourceIds": {"$ref": "#/$defs/sourceIds"}
      }
    }
  }
}
