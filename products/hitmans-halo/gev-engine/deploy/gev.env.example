# Seek First / God's Eye View — hosted owner runtime
# Copy to /etc/seek-first/gev.env and chmod 600.
# NEVER commit the populated file.

NODE_ENV=production
PORT=4173
HOST=127.0.0.1

# Cost-bearing endpoint guards. These are application-level throttles, not
# provider billing caps. Keep provider-side budgets/quotas enabled too.
GEV_RATELIMIT_OPENAI_PER_MIN=20
GEV_RATELIMIT_GOOGLE_PER_MIN=30
TOMTOM_DAILY_TILE_BUDGET=10000

# Browser-visible by design. Restrict these by hostname/API permissions at the
# provider. For owner-only deployment, direct Google 3D Tiles lets you leave
# CESIUM_ION_TOKEN blank if you do not need Cesium ion-hosted assets.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=

# OpenAI voice/HUD — server-side key.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_CONTEXT_TOKENS=3000
OPENAI_REALTIME_CONTEXT_RETENTION=0.5
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano

# OpenSky — start anonymous immediately, then switch to oauth after creating an
# OpenSky API client.
OPENSKY_AUTH_MODE=anon
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AISStream — server-side WebSocket key.
AISSTREAM_API_KEY=
VITE_AIS_LIVE_API_URL=/api/ais-live
VITE_AIS_LIVE_MAX_ROWS=12000
VITE_AIS_LIVE_LABEL_MAX_ROWS=900

# Optional providers.
LL2_API_TOKEN=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=

# Optional AIS narrowing. Leaving this commented uses the application's default.
# AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
# AISSTREAM_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport
